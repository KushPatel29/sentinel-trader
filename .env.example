# Copy to .env and fill in. Never commit .env.
# Paper keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Optional: LLM escalation for ambiguous headlines (sentiment.llm.enabled: true)
ANTHROPIC_API_KEY=

# Required in addition to mode: live and --confirm-live before real-money orders are allowed
SENTINEL_LIVE_CONFIRM=no
